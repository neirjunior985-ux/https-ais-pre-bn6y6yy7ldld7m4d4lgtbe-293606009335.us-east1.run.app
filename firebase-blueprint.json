{
  "entities": {
    "BusinessProfile": {
      "title": "Business Profile",
      "description": "Details about the service provider/business.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Business or owner name" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "logoUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name"]
    },
    "Client": {
      "title": "Client",
      "description": "Information about a client.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string", "description": "UID of the user who owns this record" }
      },
      "required": ["name", "ownerId"]
    },
    "Service": {
      "title": "Service/Product",
      "description": "A service or product that can be added to an estimate.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "unitPrice": { "type": "number" },
        "category": { "type": "string" },
        "ownerId": { "type": "string" }
      },
      "required": ["name", "unitPrice", "ownerId"]
    },
    "Estimate": {
      "title": "Estimate",
      "description": "A quote or proposal sent to a client.",
      "type": "object",
      "properties": {
        "estimateNumber": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "serviceId": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "quantity": { "type": "number" },
              "unitPrice": { "type": "number" },
              "total": { "type": "number" }
            }
          }
        },
        "subtotal": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected", "expired"]
        },
        "notes": { "type": "string" },
        "expiryDate": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["clientId", "items", "total", "status", "ownerId"]
    }
  },
  "firestore": {
    "businessProfiles/{userId}": {
      "schema": "BusinessProfile",
      "description": "Business profile for a specific user."
    },
    "clients/{clientId}": {
      "schema": "Client",
      "description": "Collection of clients."
    },
    "services/{serviceId}": {
      "schema": "Service",
      "description": "Product/Service catalog."
    },
    "estimates/{estimateId}": {
      "schema": "Estimate",
      "description": "Collection of estimates created by users."
    }
  }
}
