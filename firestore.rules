rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Business Profiles
    match /businessProfiles/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId && isValidBusinessProfile(incoming());

      function isValidBusinessProfile(data) {
        return data.keys().hasAll(['name']) &&
               data.name is string && data.name.size() <= 100 &&
               (data.get('email', '') is string) &&
               (data.get('phone', '') is string) &&
               (data.get('address', '') is string);
      }
    }

    // Clients
    match /clients/{clientId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isOwner(resource.data);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidClient(incoming());
      allow update: if isOwner(existing()) && incoming().ownerId == existing().ownerId && isValidClient(incoming());
      allow delete: if isOwner(existing());

      function isValidClient(data) {
        return data.keys().hasAll(['name', 'ownerId']) &&
               data.name is string && data.name.size() <= 200 &&
               data.ownerId == request.auth.uid;
      }
    }

    // Services
    match /services/{serviceId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isOwner(resource.data);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidService(incoming());
      allow update: if isOwner(existing()) && incoming().ownerId == existing().ownerId && isValidService(incoming());
      allow delete: if isOwner(existing());

      function isValidService(data) {
        return data.keys().hasAll(['name', 'unitPrice', 'ownerId']) &&
               data.name is string && data.name.size() <= 200 &&
               data.unitPrice is number && data.unitPrice >= 0;
      }
    }

    // Estimates
    match /estimates/{estimateId} {
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
      allow get: if isOwner(resource.data);
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid && isValidEstimate(incoming());
      allow update: if isOwner(existing()) && incoming().ownerId == existing().ownerId && isValidEstimate(incoming());
      allow delete: if isOwner(existing());

      function isValidEstimate(data) {
        return data.keys().hasAll(['clientId', 'items', 'total', 'status', 'ownerId']) &&
               data.status in ['pending', 'approved', 'rejected', 'expired'] &&
               data.items is list && data.items.size() <= 50 &&
               data.total is number && data.total >= 0;
      }
    }
  }
}
